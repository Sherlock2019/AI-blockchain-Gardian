# Copy to .env to override defaults. Everything here is optional: the project
# runs with no .env file, no API key and no network access beyond localhost.

# --- Web UI -----------------------------------------------------------------
# Port the dashboard is published on. It is the only port that needs to be
# reachable from outside the machine (see docs/DEPLOY_EC2.md).
# WEB_PORT=5173
# Extra hostnames the Vite dev server answers to (`make demo` only; Docker
# serves through nginx and needs nothing). On EC2 the public hostname is
# detected automatically. Comma-separated, or "all".
# ALLOWED_HOSTS=demo.example.com

# --- Ledger -----------------------------------------------------------------
# "hardhat" talks to a local JSON-RPC node; "memory" simulates the registry
# in-process and is labelled SIMULATED in the dashboard. scripts/dev.sh sets
# this for you.
# LEDGER_MODE=hardhat
# LEDGER_RPC_URL=http://127.0.0.1:8545
# No private key is configured anywhere: transactions are sent from the Hardhat
# node's unlocked recorder account. Do not point this at a real network.

# --- LLM --------------------------------------------------------------------
# "mock" needs nothing. "openai" uses any OpenAI-compatible endpoint.
LLM_PROVIDER=mock
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# When true, the mock model follows instructions injected into an invoice, to
# show governance holding when the model fails. Set false to see the other path.
MOCK_LLM_OBEYS_INJECTION=true

# --- Security ---------------------------------------------------------------
# Secret for the mock approval signature (HMAC). If unset, a random one is
# generated at startup, and approvals stop verifying after a restart.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# APPROVAL_SIGNING_SECRET=
# Enables the tamper-simulation and reset endpoints. Must be false anywhere real.
DEMO_MODE=true
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage and logging ----------------------------------------------------
# DATABASE_URL=sqlite:///./trustchain.db
LOG_LEVEL=INFO
